# MONGODB_URI: MongoDB Atlas connection URI string
MONGODB_URI="mongodb+srv://<username>:<password>@database.xxxx.mongodb.net/sagitarius_parcel?retryWrites=true&w=majority"
PORT=3000

# Vercel production secrets: set these in Project Settings > Environment Variables.
# Use a unique password of at least 12 characters; never commit real values here.
AUTH_BOOTSTRAP_ADMIN_USERNAME="<admin-username>"
AUTH_BOOTSTRAP_ADMIN_PASSWORD="<unique-secret-12-characters-or-more>"
AUTH_BOOTSTRAP_ADMIN_EMAIL="<admin-email>"

# Optional Korwil login; omit both values when no Korwil account is needed.
AUTH_KORWIL_USERNAME="<korwil-username>"
AUTH_KORWIL_PASSWORD="<unique-secret-12-characters-or-more>"

